<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.github.maven-nar.its.nar</groupId>
    <artifactId>it-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../it-parent/pom.xml</relativePath>
  </parent>
  <artifactId>it0045-jni-isolation</artifactId>
  <packaging>nar</packaging>
  <properties>
    <skipTests>true</skipTests>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.github.maven-nar.its.nar</groupId>
      <artifactId>it0003-jni</artifactId>
      <version>1.0-SNAPSHOT</version>
      <type>nar</type>
    </dependency>
    <dependency>
      <groupId>com.github.maven-nar.its.nar</groupId>
      <artifactId>it0007-lib-shared</artifactId>
      <version>1.0-SNAPSHOT</version>
      <type>nar</type>
    </dependency>
  </dependencies>
  <build>
    <finalName>custom-native-artifact</finalName>
    <plugins>
      <!-- The legacy native linker cannot build object paths containing spaces.
           Copy the built libraries to exercise the Java runner's loader paths. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>native-path-with-spaces</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/native output</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/nar</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>@project.groupId@</groupId>
        <artifactId>nar-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <testUnpackDirectory>${project.build.directory}/test dependencies</testUnpackDirectory>
          <forkMode>never</forkMode>
          <forkCount>0</forkCount>
          <reuseForks>true</reuseForks>
          <environmentVariables>
            <LD_LIBRARY_PATH>${basedir}/configured tail</LD_LIBRARY_PATH>
            <DYLD_LIBRARY_PATH>${basedir}/configured tail</DYLD_LIBRARY_PATH>
            <LIBPATH>${basedir}/configured tail</LIBPATH>
          </environmentVariables>
          <libraries>
            <library>
              <type>jni</type>
              <narSystemPackage>example</narSystemPackage>
              <linkCPP>false</linkCPP>
            </library>
          </libraries>
        </configuration>
        <executions>
          <execution>
            <id>default-nar-integration-test</id>
            <configuration>
              <targetDirectory>${project.build.directory}/native output</targetDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
