import java.io.File;
import java.io.FileInputStream;
import java.io.ByteArrayOutputStream;

String readText(File file) {
    FileInputStream input = new FileInputStream(file);
    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
    try {
        byte[] buffer = new byte[4096];
        int count;
        while ((count = input.read(buffer)) != -1) {
            bytes.write(buffer, 0, count);
        }
    } finally {
        input.close();
    }
    return bytes.toString("UTF-8");
}

int verifyOutputs(File directory) {
    int count = 0;
    File[] files = directory.listFiles();
    if (files == null) {
        return 0;
    }
    for (int i = 0; i < files.length; i++) {
        File file = files[i];
        if (file.getName().startsWith("nar-map-") && file.getName().endsWith(".tmp")) {
            throw new RuntimeException("Temporary map leaked: " + file);
        }
        if (file.isDirectory()) {
            count += verifyOutputs(file);
        } else if (file.getName().equals("libmap-probe %,-1.2.so") || file.getName().equals("map-probe %,-1.2")) {
            // BUILD SUCCESS is insufficient: the original -M bug did not produce a native output.
            if (file.length() == 0) {
                throw new RuntimeException("Empty native output: " + file);
            }
            File map = new File(file.getParentFile(), file.getName() + ".map");
            // Use the complete native filename so dots, prefixes, and suffixes are preserved.
            if (!map.isFile() || !readText(map).contains("nar_issue_315_map_symbol")) {
                throw new RuntimeException("Missing map or fixture symbol: " + map);
            }
            count++;
        }
    }
    return count;
}

String[] modules = {"gcc", "gcc-decorated", "gpp", "gpp-decorated"};
for (int i = 0; i < modules.length; i++) {
    int count = verifyOutputs(new File(basedir, modules[i] + "/target/nar"));
    // Each module must have a shared library, a JNI library, and an executable, each with its own map.
    if (count != 3) {
        throw new RuntimeException(modules[i] + ": expected three native outputs with maps, found " + count);
    }
}
// Maps must reach the published NAR, and temporary files must never be archived.
for (int i = 0; i < modules.length; i++) {
    File[] artifacts = new File(basedir, modules[i] + "/target").listFiles();
    int archives = 0;
    for (int j = 0; j < artifacts.length; j++) {
        if (!artifacts[j].getName().endsWith(".nar")) continue;
        java.util.zip.ZipFile archive = new java.util.zip.ZipFile(artifacts[j]);
        try {
            int maps = 0;
            java.util.Enumeration entries = archive.entries();
            while (entries.hasMoreElements()) {
                java.util.zip.ZipEntry entry = entries.nextElement();
                if (entry.getName().endsWith(".map")) maps++;
                if (entry.getName().endsWith(".tmp")) {
                    throw new RuntimeException("Temporary file archived: " + entry.getName());
                }
            }
            if (maps != 1) throw new RuntimeException("Expected one map in " + artifacts[j]);
        } finally {
            archive.close();
        }
        archives++;
    }
    if (archives != 3) throw new RuntimeException("Expected three native NARs in " + modules[i]);
}
// Replacements supply absolute paths; replay still links in the nested output directory.
void deleteLinkedOutputs(File directory) {
    File[] files = directory.listFiles();
    if (files == null) return;
    for (int i = 0; i < files.length; i++) {
        File file = files[i];
        if (file.isDirectory()) {
            deleteLinkedOutputs(file);
        } else if (file.getName().equals("libmap-probe %,-1.2.so") || file.getName().equals("map-probe %,-1.2")) {
            File map = new File(file.getParentFile(), file.getName() + ".map");
            if (!file.delete() || !map.delete()) throw new RuntimeException("Cannot remove replay output: " + file);
        }
    }
}
String[] shells = {"sh", "bash"};
for (int i = 0; i < modules.length; i++) {
    File target = new File(basedir, modules[i] + "/target");
    // The fixture must record -g so these replays exercise actual option removal.
    if (!readText(new File(target, "nar/nar-replay/link-commands")).contains("'-g'")) {
        throw new RuntimeException("Missing option-removal input in " + modules[i]);
    }
    for (int j = 0; j < shells.length; j++) {
        deleteLinkedOutputs(new File(target, "nar"));
        File script = new File(target, "nar/nar-replay/scripts/relink-" + shells[j] + ".sh");
        if (readText(script).contains("'-g'")) throw new RuntimeException("Replay retained -g: " + script);
        String[] command = {shells[j], script.getAbsolutePath()};
        Process process = new ProcessBuilder(command).directory(target.getParentFile()).redirectErrorStream(true)
            .redirectOutput(new File(target, "replay-" + shells[j] + ".log")).start();
        if (process.waitFor() != 0) throw new RuntimeException("Replay failed: " + script);
        if (verifyOutputs(new File(target, "nar")) != 3) throw new RuntimeException("Replay lost an output: " + script);
    }
}
return true;
